---
import { routes, navServices, phones, type NavId } from '../data/site';

interface Props {
  active?: NavId;
}

const { active = '' } = Astro.props;

const base = 'padding: 10px 14px; border-radius: 999px; font-weight: 700; font-size: 15px; text-decoration: none; ';
const mbase = 'display: flex; align-items: center; min-height: 48px; padding: 6px 14px; border-radius: 14px; text-decoration: none; font-weight: 800; font-size: 17px; ';
const st = (id: NavId) => base + (id === active ? 'background: #E6F4F3; color: #0A5F64;' : 'background: transparent; color: #17324D;');
const mst = (id: NavId) => mbase + (id === active ? 'background: #E6F4F3; color: #0A5F64;' : 'color: #17324D;');
const cur = (id: NavId) => (id === active ? 'page' : undefined);

const itemStyle = 'display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 8px 12px; border-radius: 14px; text-decoration: none; font-weight: 700; font-size: 15px; line-height: 1.3;';
const mItemStyle = 'display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 6px 14px 6px 28px; border-radius: 14px; text-decoration: none; font-weight: 700; font-size: 16px;';
---
<header data-dv-header style="font-family: 'Nunito', system-ui, sans-serif; color: #17324D; background: #FFFFFF; border-bottom: 1px solid #E3EEF0; position: relative; z-index: 40">
  <div class="dv-hbar" style="max-width: 1200px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px">
    <a href={routes.home} aria-label="Dr. Vira Bolok, MD — home" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #17324D">
      <img class="dv-hlogo" src="/images/logo-dark.webp" alt="Dr. Vira" width="141" height="44" style="height: 44px; width: auto; display: block">
      <span class="dv-hcta" style="padding-left: 12px; border-left: 1px solid #DCE9EB; font-size: 13px; color: #4A5D70; font-weight: 700; line-height: 1.3">Pediatrics &amp;<br>Neonatology</span>
    </a>
    <nav class="dv-navlinks" aria-label="Main" style="display: flex; gap: 2px; align-items: center">
      <a href={routes.home} aria-current={cur('home')} style={st('home')}>Home</a>
      <a href={routes.about} aria-current={cur('about')} style={st('about')}>About</a>
      <div data-dv-services style="position: relative">
        <button type="button" data-dv-services-toggle aria-expanded="false" aria-controls="dv-services-menu" style={st('services') + ' border: none; font-family: inherit; cursor: pointer; display: inline-flex; align-items: center; gap: 6px'}>
          Services
          <svg class="dv-chev-btn" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div id="dv-services-menu" hidden style="position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); width: 320px; padding: 10px; border-radius: 22px; background: #FFFFFF; border: 1px solid #E1ECEE; box-shadow: 0 20px 50px rgba(23, 50, 77, 0.16); display: flex; flex-direction: column; gap: 2px; z-index: 60">
          {navServices.map((s) => (
            <a href={s.href} class="dv-dd-item" style={itemStyle}>{s.title}</a>
          ))}
          <a href={routes.services} style="display: flex; align-items: center; justify-content: space-between; min-height: 44px; margin-top: 4px; padding: 8px 12px; border-top: 1px solid #EEF4F5; text-decoration: none; color: #0D7A80; font-weight: 800; font-size: 14px">All Services<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
        </div>
      </div>
      <a href={routes.faq} aria-current={cur('faq')} style={st('faq')}>FAQ</a>
      <a href={routes.blog} aria-current={cur('blog')} style={st('blog')}>Blog</a>
      <a href={routes.contact} aria-current={cur('contact')} style={st('contact')}>Contact</a>
    </nav>
    <div style="display: flex; gap: 10px; align-items: center">
      <a class="dv-hbook" href={routes.book} aria-current={cur('book')} style="display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px; border-radius: 999px; background: #0D7A80; color: #FFFFFF; font-weight: 800; font-size: 15px; text-decoration: none; white-space: nowrap">Book Appointment</a>
      <button class="dv-menu" type="button" data-dv-menu-toggle aria-expanded="false" aria-controls="dv-mobile-menu" aria-label="Open menu" style="width: 46px; height: 46px; border-radius: 14px; border: 1px solid #D5E5E7; background: #FFFFFF; color: #17324D; align-items: center; justify-content: center; cursor: pointer">
        <svg data-dv-icon-close width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
        <svg data-dv-icon-open width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
      </button>
    </div>
  </div>

  <nav id="dv-mobile-menu" hidden aria-label="Mobile" style="border-top: 1px solid #E3EEF0; background: #FFFFFF; padding: 12px 20px 22px; display: flex; flex-direction: column; gap: 2px; box-shadow: 0 18px 40px rgba(23, 50, 77, 0.12)">
    <a href={routes.home} aria-current={cur('home')} style={mst('home')}>Home</a>
    <a href={routes.about} aria-current={cur('about')} style={mst('about')}>About Dr. Vira</a>
    <span style="padding: 14px 14px 4px; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">Services</span>
    {navServices.map((s) => (
      <a href={s.href} class="dv-dd-item" style={mItemStyle}>{s.title}</a>
    ))}
    <a href={routes.services} style="display: flex; align-items: center; min-height: 48px; padding: 6px 14px 6px 28px; border-radius: 14px; text-decoration: none; color: #0D7A80; font-weight: 800; font-size: 16px">All Services →</a>
    <span aria-hidden="true" style="height: 1px; background: #EEF4F5; margin: 8px 0"></span>
    <a href={routes.book} aria-current={cur('book')} style={mst('book')}>Book an Appointment</a>
    <a href={routes.faq} aria-current={cur('faq')} style={mst('faq')}>FAQ</a>
    <a href={routes.blog} aria-current={cur('blog')} style={mst('blog')}>Blog</a>
    <a href={routes.contact} aria-current={cur('contact')} style={mst('contact')}>Contact</a>
    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding-top: 12px">
      <a href={phones.cumc.tel} style="display: flex; flex-direction: column; justify-content: center; min-height: 58px; padding: 6px 14px; border-radius: 16px; background: #0D7A80; color: #FFFFFF; text-decoration: none; line-height: 1.25"><span style="font-size: 12px; font-weight: 700; color: #DDF2F1">Call CUMC</span><span style="font-size: 15px; font-weight: 800">{phones.cumc.display}</span></a>
      <a href={phones.mrxu.tel} style="display: flex; flex-direction: column; justify-content: center; min-height: 58px; padding: 6px 14px; border-radius: 16px; background: #E6F4F3; color: #0A5F64; text-decoration: none; line-height: 1.25"><span style="font-size: 12px; font-weight: 700">Call Maria Reyna–XU</span><span style="font-size: 15px; font-weight: 800">{phones.mrxu.display}</span></a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-dv-header]');
  if (header) {
    const svcWrap = header.querySelector<HTMLElement>('[data-dv-services]');
    const svcBtn = header.querySelector<HTMLButtonElement>('[data-dv-services-toggle]');
    const svcMenu = header.querySelector<HTMLElement>('#dv-services-menu');
    const menuBtn = header.querySelector<HTMLButtonElement>('[data-dv-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('#dv-mobile-menu');

    const setServices = (open: boolean) => {
      if (!svcBtn || !svcMenu) return;
      svcBtn.setAttribute('aria-expanded', String(open));
      svcMenu.hidden = !open;
    };
    const setMenu = (open: boolean) => {
      if (!menuBtn || !menu) return;
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
    };

    svcBtn?.addEventListener('click', () => setServices(svcBtn.getAttribute('aria-expanded') !== 'true'));
    menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));

    // Close the services dropdown on outside click or Escape.
    document.addEventListener('click', (e) => {
      if (svcWrap && !svcWrap.contains(e.target as Node)) setServices(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (svcBtn?.getAttribute('aria-expanded') === 'true') {
        setServices(false);
        svcBtn.focus();
      }
      if (menuBtn?.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuBtn.focus();
      }
    });
    // Collapse the mobile menu if the viewport grows past the breakpoint.
    window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
      if (e.matches) setMenu(false);
    });
  }
</script>
