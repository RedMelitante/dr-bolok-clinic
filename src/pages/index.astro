---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCards from '../components/StatCards.astro';
import FaqList from '../components/FaqList.astro';
import { clinics, weekDays, maps, homeFaqs } from '../data/site';

const dayBase = 'width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; ';

const places = [
  { name: 'Capitol University Medical Center', detail: 'Room 206B, Gusa Highway, Cagayan de Oro City, Misamis Oriental', tag: 'Clinic · Mon, Tue, Thu, Fri AM', teal: true, map: maps.cumc },
  { name: 'Maria Reyna–Xavier University Hospital', detail: 'Room 547, Cagayan de Oro City', tag: 'Clinic · Tue, Thu, Fri PM', teal: true, map: maps.mrxu },
  { name: 'J.R. Borja General Hospital', detail: 'Medical Specialist IV, Pediatrics', tag: 'Hospital affiliation', teal: false, map: maps.jrb },
  { name: 'Madonna and Child Medical Center', detail: 'Hospital affiliation', tag: 'Hospital affiliation', teal: false, map: maps.madonna },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: 'Dr. Viraliza June Abejuela Bolok, MD',
  alternateName: 'Dr. Vira Bolok',
  description: 'Board-certified pediatrician and neonatologist providing newborn and child care in Cagayan de Oro.',
  medicalSpecialty: ['Pediatric', 'Neonatal'],
  areaServed: 'Cagayan de Oro City, Misamis Oriental, Philippines',
  location: clinics.map((c) => ({
    '@type': 'MedicalClinic',
    name: c.name,
    telephone: c.tel.replace('tel:', ''),
    address: {
      '@type': 'PostalAddress',
      streetAddress: c.address.replace(', Cagayan de Oro City', ''),
      addressLocality: 'Cagayan de Oro City',
      addressRegion: 'Misamis Oriental',
      addressCountry: 'PH',
    },
  })),
};
---
<BaseLayout
  title="Home — Dr. Vira Bolok, MD"
  description="Dr. Viraliza June Abejuela Bolok is a board-certified pediatrician and neonatologist caring for newborns and children at Capitol University Medical Center and Maria Reyna–Xavier University Hospital in Cagayan de Oro."
  active="home"
  jsonLd={jsonLd}
>
<!-- HERO -->
<section style="background: #F2F9F8; position: relative; overflow: hidden">
  <div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #E1F1F0; right: -120px; top: -140px"></div>
  <div aria-hidden="true" style="position: absolute; width: 180px; height: 180px; border-radius: 50%; background: #FFE7DC; left: -60px; bottom: -70px"></div>
  <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(40px, 7vw, 88px) 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
    <div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
      <span style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px; background: #FFFFFF; border: 1px solid #D5E9E8; font-size: 14px; font-weight: 800; color: #0A5F64">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
        Board-certified Pediatrician · Neonatologist
      </span>
      <h1 style="margin: 0; font-size: clamp(36px, 5vw, 60px); line-height: 1.08; font-weight: 800; letter-spacing: -0.01em">Compassionate Newborn &amp; Child Care in Cagayan de Oro</h1>
      <p style="margin: 0; font-size: clamp(17px, 1.6vw, 20px); color: #3F5368; max-width: 560px">Dr. Viraliza June Abejuela Bolok is a board-certified pediatrician and neonatologist dedicated to the health and development of your child, from their very first days of life through childhood.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px">
        <a href="/book/" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 999px; background: #0D7A80; color: #FFFFFF; font-weight: 800; font-size: 17px; text-decoration: none; box-shadow: 0 8px 20px rgba(13, 122, 128, 0.22)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          Book an Appointment
        </a>
        <a href="#clinics" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; background: #FFFFFF; border: 2px solid #0D7A80; color: #0D7A80; font-weight: 800; font-size: 17px; text-decoration: none">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
          Call the Clinic
        </a>
      </div>
      <div style="display: flex; align-items: center; gap: 10px; font-size: 15px; color: #4A5D70; font-weight: 600">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        Clinics at Capitol University Medical Center &amp; Maria Reyna–Xavier University Hospital
      </div>
    </div>
    <div style="flex: 1 1 400px; min-width: 0; position: relative; padding: 0 0 28px 0">
      <div style="position: relative; aspect-ratio: 4 / 4.6; max-width: 500px; margin: 0 auto">
        <div aria-hidden="true" style="position: absolute; left: 6%; right: 6%; bottom: 0; aspect-ratio: 1 / 1; border-radius: 50%; background: #CDE9E7"></div>
        <div aria-hidden="true" style="position: absolute; width: 22%; aspect-ratio: 1 / 1; border-radius: 50%; background: #FFE1D4; left: 0; top: 18%"></div>
        <img src="/images/vira-portrait.webp" fetchpriority="high" width="500" height="700" alt="Dr. Viraliza June Bolok in a white coat" style="position: absolute; left: 0; right: 0; bottom: 0; margin: 0 auto; height: 100%; width: auto; max-width: 100%; object-fit: contain; object-position: bottom center; display: block">
      </div>
      <div style="position: absolute; left: -12px; bottom: 0; display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-radius: 22px; background: #FFFFFF; box-shadow: 0 14px 36px rgba(23, 50, 77, 0.14); max-width: 300px">
        <span style="width: 48px; height: 48px; border-radius: 16px; background: #FFF1EA; display: flex; align-items: center; justify-content: center; flex-shrink: 0">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#B4492F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"></path></svg>
        </span>
        <span style="display: flex; flex-direction: column; line-height: 1.3">
          <span style="font-weight: 800; font-size: 16px">Neonatology sub-specialist</span>
          <span style="font-size: 14px; color: #4A5D70">Newborn &amp; premature infant care</span>
        </span>
      </div>
      <div style="position: absolute; right: -8px; bottom: 120px; padding: 12px 18px; border-radius: 18px; background: #FFFFFF; box-shadow: 0 14px 36px rgba(23, 50, 77, 0.12); display: flex; flex-direction: column; line-height: 1.2">
        <span style="font-size: 13px; color: #4A5D70; font-weight: 700">Licensed physician</span>
        <span style="font-size: 22px; font-weight: 800; color: #0A5F64">since 2014</span>
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<section style="padding: clamp(40px, 5vw, 64px) 0 clamp(8px, 2vw, 16px)">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px">
      <StatCards variant="home" />
    </div>
  </div>
</section>

<!-- SERVICE ICONS -->
<section aria-label="Services" style="background: #FFFFFF">
  <div style="max-width: 1200px; margin: 0 auto; padding: clamp(28px, 4vw, 44px) 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px">
      <a href="/services/newborn-neonatal-care/" class="dv-svc" style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18px; padding: 30px 18px 26px; border-radius: 26px; text-decoration: none;">
        <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="url(#gNb)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="gNb" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3CC8C0"></stop><stop offset="1" stop-color="#4F7FE6"></stop></linearGradient></defs><path d="M8.6 3.6c2.1-1.2 4.7-1.2 6.8 0 1.9 1.1 2.1 3.4.8 5.6L9.2 19.8"></path><path d="M8.6 3.6C6.9 4.7 6.7 7 8 9.2l6.8 10.6"></path><path d="M9.2 19.8 6.4 20.6l1.1-2.4-2.6-.2"></path><path d="M14.8 19.8l2.8.8-1.1-2.4 2.6-.2"></path><path d="M9.6 6.2c1.5-.8 3.3-.8 4.8 0"></path></svg>
        <span style="font-size: 19px; font-weight: 800; line-height: 1.35; color: #3B4A5E; text-align: center">Newborn Care</span>
      </a>
      <a href="/services/child-vaccinations/" class="dv-svc" style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18px; padding: 30px 18px 26px; border-radius: 26px; text-decoration: none;">
        <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="url(#gVx)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="gVx" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3CC8C0"></stop><stop offset="1" stop-color="#4F7FE6"></stop></linearGradient></defs><path d="M10 8c-2.9 3.6-4.6 6.2-4.6 8.6a4.6 4.6 0 0 0 9.2 0C14.6 14.2 12.9 11.6 10 8z"></path><path d="M16.6 3c-1.6 2-2.7 3.5-2.7 4.9a2.7 2.7 0 0 0 5.4 0c0-1.4-1.1-2.9-2.7-4.9z"></path><path d="M10 14.6v4M8 16.6h4"></path></svg>
        <span style="font-size: 19px; font-weight: 800; line-height: 1.35; color: #3B4A5E; text-align: center">Vaccinations &amp; Immunization</span>
      </a>
      <a href="/services/well-baby-growth-monitoring/" class="dv-svc" style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18px; padding: 30px 18px 26px; border-radius: 26px; text-decoration: none;">
        <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="url(#gGr)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="gGr" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3CC8C0"></stop><stop offset="1" stop-color="#4F7FE6"></stop></linearGradient></defs><path d="M6 3.5v4.2a4.5 4.5 0 0 0 9 0V3.5"></path><path d="M5 3.5h2M14 3.5h2"></path><path d="M10.5 12.2v2.8a4.5 4.5 0 0 0 9 0v-2.4"></path><circle cx="19.5" cy="10.4" r="2.1"></circle><circle cx="19.5" cy="10.4" r=".8"></circle></svg>
        <span style="font-size: 19px; font-weight: 800; line-height: 1.35; color: #3B4A5E; text-align: center">Growth &amp; Nutrition Monitoring</span>
      </a>
      <a href="/services/common-childhood-illnesses/" class="dv-svc" style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18px; padding: 30px 18px 26px; border-radius: 26px; text-decoration: none;">
        <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="url(#gIl)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="gIl" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3CC8C0"></stop><stop offset="1" stop-color="#4F7FE6"></stop></linearGradient></defs><path d="M14 14.2V4a2 2 0 0 0-4 0v10.2a4 4 0 1 0 4 0z"></path><circle cx="12" cy="17.4" r="1.5"></circle><path d="M12 15.9V8"></path><path d="M16.5 5h2M16.5 8h2M16.5 11h1.5"></path><path d="M5 6.2c.7-.5 1.3.5 2 0M5 8.2c.7-.5 1.3.5 2 0"></path></svg>
        <span style="font-size: 19px; font-weight: 800; line-height: 1.35; color: #3B4A5E; text-align: center">Common Childhood Illnesses</span>
      </a>
      <a href="/services/high-risk-infant-follow-up/" class="dv-svc" style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 18px; padding: 30px 18px 26px; border-radius: 26px; text-decoration: none;">
        <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="url(#gHr)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="gHr" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3CC8C0"></stop><stop offset="1" stop-color="#4F7FE6"></stop></linearGradient></defs><circle cx="8.5" cy="12" r="5.2"></circle><path d="M8 6.8c-.3-1 .2-1.8 1-1.8"></path><path d="M6.8 11.2h.01M10.2 11.2h.01"></path><path d="M6.8 13.8c.9.8 2.5.8 3.4 0"></path><path d="M14.5 15.2h1.8l1.1-2.6 1.4 4.2 1-2.1h2.2"></path><path d="M20.4 11.6c.4-.6 1.4-.4 1.4.4 0 .6-.9 1.2-1.4 1.6-.5-.4-1.4-1-1.4-1.6 0-.8 1-1 1.4-.4z"></path></svg>
        <span style="font-size: 19px; font-weight: 800; line-height: 1.35; color: #3B4A5E; text-align: center">High-Risk Infant Follow-up</span>
      </a>
  </div>
</section>

<!-- HAVE QUESTIONS -->
<section style="padding: clamp(40px, 5vw, 64px) 0 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: clamp(28px, 4vw, 40px); border-radius: 32px; background: #E6F4F3">
      <div style="flex: 1 1 460px; display: flex; flex-direction: column; gap: 8px">
        <h2 style="margin: 0; font-size: clamp(24px, 2.8vw, 32px); line-height: 1.2; font-weight: 800">Have Questions About Your Child’s Health?</h2>
        <p style="margin: 0; color: #3F5368">Reach out to Dr. Vira’s clinic to schedule a consultation, ask about your child’s symptoms, or set up a newborn checkup.</p>
      </div>
      <a href="/book/" style="display: inline-flex; align-items: center; min-height: 56px; padding: 0 28px; border-radius: 999px; background: #0D7A80; color: #FFFFFF; font-weight: 800; text-decoration: none; white-space: nowrap">Book an Appointment</a>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services" style="padding: clamp(64px, 8vw, 104px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 40px">
    <div style="display: flex; flex-direction: column; gap: 12px; max-width: 680px">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">Our Services</span>
      <h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.15; font-weight: 800">Complete Care From Newborn to Childhood</h2>
      <p style="margin: 0; color: #3F5368">Dr. Vira provides comprehensive pediatric and neonatal care, focused on your child’s healthy growth at every stage.</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px">
      <a href="/services/newborn-neonatal-care/" style="display: flex; flex-direction: column; gap: 14px; padding: 14px 14px 26px; border-radius: 28px; border: 1px solid #E1ECEE; background: #FFFFFF; text-decoration: none; color: #17324D; box-shadow: 0 6px 20px rgba(23, 50, 77, 0.04)">
        <img loading="lazy" src="/images/newborn-bassinet-n.webp" alt="A newborn resting in a hospital bassinet" style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 45%; border-radius: 20px; display: block">
        <span style="margin-top: -44px; margin-left: 16px; border: 4px solid #FFFFFF; position: relative; width: 56px; height: 56px; border-radius: 18px; background: #E6F4F3; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg></span>
        <span style="font-size: 21px; font-weight: 800; line-height: 1.25; padding: 0 14px">Newborn &amp; Neonatal Care</span>
        <span style="font-size: 16px; color: #4A5D70; padding: 0 14px">Specialized care for newborns, including premature and high-risk infants, from their first days of life.</span>
        <span style="margin-top: auto; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; color: #0D7A80; font-size: 16px">Read More <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
      </a>
      <a href="/services/well-baby-growth-monitoring/" style="display: flex; flex-direction: column; gap: 14px; padding: 14px 14px 26px; border-radius: 28px; border: 1px solid #E1ECEE; background: #FFFFFF; text-decoration: none; color: #17324D; box-shadow: 0 6px 20px rgba(23, 50, 77, 0.04)">
        <img loading="lazy" src="/images/baby-blanket-n.webp" alt="A smiling baby lying on a soft white blanket" style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 50%; border-radius: 20px; display: block">
        <span style="margin-top: -44px; margin-left: 16px; border: 4px solid #FFFFFF; position: relative; width: 56px; height: 56px; border-radius: 18px; background: #FFF1EA; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#B4492F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="14 7 21 7 21 14"></polyline></svg></span>
        <span style="font-size: 21px; font-weight: 800; line-height: 1.25; padding: 0 14px">Well-Baby &amp; Growth Monitoring</span>
        <span style="font-size: 16px; color: #4A5D70; padding: 0 14px">Regular checkups tracking your child’s growth, weight, and developmental milestones.</span>
        <span style="margin-top: auto; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; color: #0D7A80; font-size: 16px">Read More <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
      </a>
      <a href="/services/child-vaccinations/" style="display: flex; flex-direction: column; gap: 14px; padding: 14px 14px 26px; border-radius: 28px; border: 1px solid #E1ECEE; background: #FFFFFF; text-decoration: none; color: #17324D; box-shadow: 0 6px 20px rgba(23, 50, 77, 0.04)">
        <img loading="lazy" src="/images/girl-vaccine-n.webp" alt="A little girl smiling at the bandage on her arm after a vaccine" style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center 35%; border-radius: 20px; display: block">
        <span style="margin-top: -44px; margin-left: 16px; border: 4px solid #FFFFFF; position: relative; width: 56px; height: 56px; border-radius: 18px; background: #EAF3FB; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1F5F8F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2l4 4"></path><path d="M17 7l3-3"></path><path d="M19 9 8.7 19.3a1 1 0 0 1-1.4 0l-2.6-2.6a1 1 0 0 1 0-1.4L15 5"></path><path d="M9 11l4 4"></path><path d="M5 19l-3 3"></path><path d="M14 4l6 6"></path></svg></span>
        <span style="font-size: 21px; font-weight: 800; line-height: 1.25; padding: 0 14px">Child Vaccinations</span>
        <span style="font-size: 16px; color: #4A5D70; padding: 0 14px">Complete immunization schedules to protect your child against preventable diseases.</span>
        <span style="margin-top: auto; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; color: #0D7A80; font-size: 16px">Read More <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
      </a>
