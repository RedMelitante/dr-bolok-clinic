---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts, routes, phones, type Post } from '../../data/site';

export function getStaticPaths() {
  return Object.values(posts).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

interface Props {
  p: Post;
}

const { p } = Astro.props;
const others = Object.values(posts).filter((o) => o.slug !== p.slug);
const tagStyle = `align-self: flex-start; padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 800; background: ${p.tag.bg}; color: ${p.tag.fg};`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p.title,
  description: p.excerpt,
  datePublished: p.isoDate,
  author: { '@type': 'Person', name: 'Queenelyn Mercado' },
  publisher: { '@type': 'Organization', name: 'Dr. Vira Bolok, MD' },
};
---
<BaseLayout title={`${p.title} — Dr. Vira`} description={p.excerpt} active="blog" image={p.img} jsonLd={jsonLd}>
<!-- ARTICLE HEADER -->
<section style="background: #F2F9F8">
  <div style="max-width: 1200px; margin: 0 auto; padding: 28px 24px 0; display: flex; flex-direction: column; gap: 20px">
    <nav aria-label="Breadcrumb" style="font-size: 15px; font-weight: 700; color: #4A5D70; display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
      <a href={routes.home} style="color: #0D7A80; text-decoration: none">Home</a><span aria-hidden="true">›</span>
      <a href={routes.blog} style="color: #0D7A80; text-decoration: none">Blog</a><span aria-hidden="true">›</span>
      <span aria-current="page">{p.category}</span>
    </nav>
    <div style="max-width: 860px; display: flex; flex-direction: column; gap: 16px">
      <span style={tagStyle}>{p.category}</span>
      <h1 style="margin: 0; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.12; font-weight: 800">{p.title}</h1>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; font-size: 15px; font-weight: 700; color: #4A5D70">
        <span style="display: inline-flex; align-items: center; gap: 10px"><span aria-hidden="true" style="width: 36px; height: 36px; border-radius: 50%; background: #CDE9E7; color: #0A5F64; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800">QM</span><span>Queenelyn Mercado</span></span>
        <span style="display: inline-flex; align-items: center; gap: 6px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg><time datetime={p.isoDate}>{p.date}</time></span>
        <span style="display: inline-flex; align-items: center; gap: 6px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>{p.read}</span>
      </div>
    </div>
    <img src={p.img} alt={p.alt} fetchpriority="high" style={`width: 100%; aspect-ratio: 21 / 9; object-fit: cover; object-position: ${p.pos}; border-radius: 32px; display: block; margin-bottom: -60px; box-shadow: 0 20px 50px rgba(23, 50, 77, 0.12)`}>
  </div>
</section>

<!-- BODY + SIDEBAR -->
<section style="padding: 100px 0 clamp(64px, 8vw, 96px)">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
    <article style="flex: 999 1 560px; min-width: 0; max-width: 760px; display: flex; flex-direction: column; gap: 28px">
      <p style="margin: 0; font-size: 20px; line-height: 1.65; color: #2C4259">{p.lead}</p>
      {p.sections.map((sec) => (
        <div style="display: flex; flex-direction: column; gap: 12px">
          {sec.h && <h2 style="margin: 0; font-size: 28px; line-height: 1.25; font-weight: 800">{sec.h}</h2>}
          <p style="margin: 0; font-size: 18px; line-height: 1.75; color: #3F5368">{sec.p}</p>
          {sec.list && (
            <ul style="margin: 4px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px">
              {sec.list.map((li) => (
                <li style="display: flex; gap: 12px; align-items: flex-start; padding: 14px 18px; border-radius: 16px; background: #FFF6F1; font-size: 17px; line-height: 1.55"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B4492F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12" y2="16"></line></svg><span>{li}</span></li>
              ))}
            </ul>
          )}
          {sec.gallery && (
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 10px">
              {sec.gallery.map((g) => (
                <img src={g.src} alt={g.alt} loading="lazy" style={`width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: ${g.pos}; border-radius: 22px; display: block`}>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href={p.serviceHref} style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 24px; border-radius: 24px; border: 1px solid #DCEAEC; text-decoration: none; color: #17324D">
        <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">Related service</span><span style="font-size: 20px; font-weight: 800">{p.serviceTitle}</span></span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </article>

    <aside style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
      <div style="display: flex; flex-direction: column; gap: 14px; padding: 26px; border-radius: 28px; background: #E6F4F3">
        <h2 style="margin: 0; font-size: 21px; font-weight: 800">Have any questions?</h2>
        <p style="margin: 0; font-size: 16px; color: #3F5368">Reach out to Dr. Vira’s clinic. We’re happy to help with scheduling or any questions about your child’s care.</p>
        <a href={phones.cumc.tel} style="display: flex; flex-direction: column; min-height: 60px; justify-content: center; padding: 8px 18px; border-radius: 18px; background: #0D7A80; color: #FFFFFF; text-decoration: none; line-height: 1.25"><span style="font-size: 13px; font-weight: 700; color: #DDF2F1">CUMC</span><span style="font-size: 19px; font-weight: 800">{phones.cumc.display}</span></a>
        <a href={phones.mrxu.tel} style="display: flex; flex-direction: column; min-height: 60px; justify-content: center; padding: 8px 18px; border-radius: 18px; background: #FFFFFF; border: 2px solid #0D7A80; color: #0A5F64; text-decoration: none; line-height: 1.25"><span style="font-size: 13px; font-weight: 700">Maria Reyna–XU Hospital</span><span style="font-size: 19px; font-weight: 800">{phones.mrxu.display}</span></a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 14px; padding: 26px; border-radius: 28px; border: 1px solid #E1ECEE">
        <h2 style="margin: 0; font-size: 19px; font-weight: 800">More for parents</h2>
        {others.map((o) => (
          <a href={o.href} style="display: flex; gap: 14px; align-items: center; text-decoration: none; color: #17324D">
            <img src={o.img} alt="" loading="lazy" style="width: 76px; height: 76px; border-radius: 16px; object-fit: cover; flex-shrink: 0">
            <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-weight: 800; line-height: 1.3">{o.title}</span><span style="font-size: 14px; color: #4A5D70; font-weight: 700">{o.date}</span></span>
          </a>
        ))}
        <a href={routes.blog} style="display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 800; color: #0D7A80; text-decoration: none">All articles <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      <a href={routes.book} style="display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; border-radius: 999px; background: #123049; color: #FFFFFF; font-weight: 800; text-decoration: none">Book an Appointment</a>
    </aside>
  </div>
</section>
</BaseLayout>
