---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogOrder } from '../../data/site';

const chips = ['All', 'Vaccines', 'Growth & development', 'Childhood illnesses'];
---
<BaseLayout
  title="Blog — Dr. Vira Bolok, MD"
  description="Simple, trustworthy guides for parents on newborn care, vaccines, growth and everyday childhood illnesses, from Dr. Vira’s clinic in Cagayan de Oro."
  active="blog"
>
<!-- HERO -->
<section style="background: #F2F9F8; position: relative; overflow: hidden">
  <div aria-hidden="true" style="position: absolute; width: 320px; height: 320px; border-radius: 50%; background: #E1F1F0; right: -80px; top: -120px"></div>
  <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) 24px; display: flex; flex-direction: column; gap: 16px">
    <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">News &amp; articles</span>
    <h1 style="margin: 0; font-size: clamp(36px, 5vw, 56px); line-height: 1.08; font-weight: 800; max-width: 760px">Health tips for parents, from Dr. Vira’s clinic</h1>
    <p style="margin: 0; font-size: clamp(17px, 1.6vw, 20px); color: #3F5368; max-width: 640px">Simple, trustworthy guides on newborn care, vaccines, growth and everyday childhood illnesses.</p>
    <div role="group" aria-label="Filter by topic" data-dv-chips style="display: flex; flex-wrap: wrap; gap: 10px; padding-top: 8px">
        {chips.map((label, i) => (
          <button type="button" class="dv-chip" data-dv-topic={label} aria-pressed={i === 0 ? 'true' : 'false'} style="min-height: 44px; padding: 0 18px; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 800; cursor: pointer;">{label}</button>
        ))}
    </div>
  </div>
</section>

<!-- POSTS -->
<section style="padding: clamp(56px, 7vw, 88px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
    {blogOrder.map((p, i) => (
      <a href={p.href} data-dv-post={p.category} style="display: flex; flex-wrap: wrap; border-radius: 32px; overflow: hidden; background: #FFFFFF; border: 1px solid #E1ECEE; text-decoration: none; color: #17324D; box-shadow: 0 10px 30px rgba(23, 50, 77, 0.05)">
        <img src={p.img} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} style={`flex: 1 1 420px; min-width: 0; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: ${p.pos}; display: block`}>
        <div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; padding: clamp(24px, 3vw, 44px); justify-content: center">
          <span style={`align-self: flex-start; padding: 5px 14px; border-radius: 999px; font-size: 13px; font-weight: 800; background: ${p.tag.bg}; color: ${p.tag.fg};`}>{p.category}</span>
          <span style="font-size: clamp(24px, 2.6vw, 32px); font-weight: 800; line-height: 1.2">{p.title}</span>
          <span style="font-size: 17px; color: #4A5D70">{p.excerpt}</span>
          <span style="font-size: 15px; color: #4A5D70; font-weight: 700">{p.date} · {p.read}</span>
          <span style="display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: #0D7A80">Read article <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
        </div>
      </a>
    ))}
    <p data-dv-empty hidden style="margin: 0; padding: 24px; border-radius: 20px; background: #F7FBFB; color: #4A5D70; font-weight: 700">No articles in this topic yet. Check back soon.</p>
  </div>
</section>

<!-- QUESTIONS + FACEBOOK -->
<section style="padding: 0 0 clamp(64px, 8vw, 96px)">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px">
    <div style="display: flex; flex-direction: column; gap: 14px; padding: 32px; border-radius: 32px; background: #0D7A80; color: #FFFFFF">
      <h2 style="margin: 0; font-size: 26px; font-weight: 800">Have a question about your child?</h2>
      <p style="margin: 0; color: #E3F4F3">Call Dr. Vira’s clinic. The secretary can help with scheduling or pass your question along.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 10px">
        <a href="tel:+639274286149" style="display: inline-flex; flex-direction: column; justify-content: center; min-height: 60px; padding: 6px 20px; border-radius: 18px; background: #FFFFFF; color: #123049; text-decoration: none; line-height: 1.25"><span style="font-size: 13px; font-weight: 800; color: #0A5F64">CUMC</span><span style="font-size: 18px; font-weight: 800">0927 428 6149</span></a>
        <a href="tel:+639352894650" style="display: inline-flex; flex-direction: column; justify-content: center; min-height: 60px; padding: 6px 20px; border-radius: 18px; background: #FFFFFF; color: #123049; text-decoration: none; line-height: 1.25"><span style="font-size: 13px; font-weight: 800; color: #0A5F64">Maria Reyna–XU</span><span style="font-size: 18px; font-weight: 800">0935 289 4650</span></a>
      </div>
    </div>
  </div>
</section>
<script>
  const group = document.querySelector<HTMLElement>('[data-dv-chips]');
  const posts = document.querySelectorAll<HTMLElement>('[data-dv-post]');
  const empty = document.querySelector<HTMLElement>('[data-dv-empty]');
  group?.querySelectorAll<HTMLButtonElement>('[data-dv-topic]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const topic = chip.dataset.dvTopic;
      group.querySelectorAll('[data-dv-topic]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      posts.forEach((p) => {
        const match = topic === 'All' || p.dataset.dvPost === topic;
        p.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  });
</script>
</BaseLayout>
