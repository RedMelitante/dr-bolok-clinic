---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../data/site';

const links = [
  { title: 'Newborn & Neonatal Care', href: routes.svcNewborn },
  { title: 'Child Vaccinations', href: routes.svcVaccines },
  { title: 'Well-Baby & Growth Monitoring', href: routes.svcWellBaby },
  { title: 'Clinic schedules', href: routes.book },
  { title: 'Frequently asked questions', href: routes.faq },
  { title: 'Articles for parents', href: routes.blog },
  { title: 'About Dr. Vira', href: routes.about },
  { title: 'Contact the clinic', href: routes.contact },
];
---
<BaseLayout
  title="Page not found — Dr. Vira Bolok, MD"
  description="The page may have moved, or the link might be out of date."
  noindex
>
<section style="background: #F2F9F8; position: relative; overflow: hidden">
  <div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #E1F1F0; right: -140px; top: -160px"></div>
  <div aria-hidden="true" style="position: absolute; width: 200px; height: 200px; border-radius: 50%; background: #FFE7DC; left: -70px; bottom: -80px"></div>
  <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
    <div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
      <span style="font-size: clamp(88px, 12vw, 150px); line-height: 0.9; font-weight: 800; color: #0D7A80; letter-spacing: -0.02em">404</span>
      <h1 style="margin: 0; font-size: clamp(30px, 4vw, 46px); line-height: 1.12; font-weight: 800">We can’t find that page</h1>
      <p style="margin: 0; font-size: clamp(17px, 1.6vw, 19px); color: #3F5368; max-width: 520px">The page may have moved, or the link might be out of date. Let’s get you back to caring for your little one.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px">
        <a href="/" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 999px; background: #0D7A80; color: #FFFFFF; font-weight: 800; font-size: 17px; text-decoration: none">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path></svg>
          Back to Home
        </a>
        <a href="/book/" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; background: #FFFFFF; border: 2px solid #0D7A80; color: #0D7A80; font-weight: 800; font-size: 17px; text-decoration: none">Book an Appointment</a>
      </div>
    </div>
    <div style="flex: 1 1 340px; min-width: 0; display: flex; justify-content: center">
      <img src="/images/baby-blanket-n.webp" alt="A smiling baby lying on a soft white blanket" style="width: 100%; max-width: 440px; aspect-ratio: 1 / 1; object-fit: cover; object-position: 78% center; border-radius: 50%; border: 8px solid #FFFFFF; box-sizing: border-box; display: block; box-shadow: 0 24px 60px rgba(23, 50, 77, 0.12)">
    </div>
  </div>
</section>

<section style="padding: clamp(56px, 7vw, 88px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 24px">
    <h2 style="margin: 0; font-size: 26px; font-weight: 800">Maybe you were looking for…</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px">
      {links.map((l) => (
        <a href={l.href} style="display: flex; justify-content: space-between; align-items: center; gap: 10px; min-height: 64px; padding: 16px 20px; border-radius: 20px; border: 1px solid #E1ECEE; text-decoration: none; color: #17324D; font-weight: 800">{l.title}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      ))}
    </div>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding: 20px 24px; border-radius: 22px; background: #E6F4F3">
      <span style="font-weight: 800">Need help right away? Call the clinic:</span>
      <a href="tel:+639274286149" style="font-weight: 800; color: #0A5F64; min-height: 44px; display: inline-flex; align-items: center">CUMC 0927 428 6149</a>
      <a href="tel:+639352894650" style="font-weight: 800; color: #0A5F64; min-height: 44px; display: inline-flex; align-items: center">Maria Reyna–XU 0935 289 4650</a>
    </div>
  </div>
</section>
</BaseLayout>
