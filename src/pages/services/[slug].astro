---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import { services, routes, phones, type Service } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

interface Props {
  s: Service;
}

const { s } = Astro.props;

const tints = ['background: #E6F4F3; color: #0D7A80;', 'background: #FFF1EA; color: #B4492F;', 'background: #EAF3FB; color: #1F5F8F;'];
const covers = s.covers.map((t, i) => ({
  t,
  dot: 'width: 36px; height: 36px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; ' + tints[i % 3],
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: s.title,
  description: s.intro1,
  about: { '@type': 'MedicalSpecialty', name: 'Pediatrics' },
};
---
<BaseLayout title={s.pageTitle} description={s.intro1} active="services" image={s.img1} jsonLd={jsonLd}>
<!-- HERO -->
<section style="background: #F2F9F8; position: relative; overflow: hidden">
  <div aria-hidden="true" style="position: absolute; width: 360px; height: 360px; border-radius: 50%; background: #E1F1F0; right: -100px; bottom: -160px"></div>
  <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: 28px 24px clamp(40px, 6vw, 72px); display: flex; flex-direction: column; gap: 28px">
    <nav aria-label="Breadcrumb" style="font-size: 15px; font-weight: 700; color: #4A5D70; display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
      <a href={routes.home} style="color: #0D7A80; text-decoration: none">Home</a><span aria-hidden="true">›</span>
      <a href={routes.services} style="color: #0D7A80; text-decoration: none">Services</a><span aria-hidden="true">›</span>
      <span aria-current="page">{s.title}</span>
    </nav>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
      <div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
        <span style="align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: #FFFFFF; border: 1px solid #D5E9E8; font-size: 14px; font-weight: 800; color: #0A5F64">{s.title}</span>
        <h1 style="margin: 0; font-size: clamp(34px, 4.6vw, 54px); line-height: 1.1; font-weight: 800">{s.headline}</h1>
        <p style="margin: 0; font-size: clamp(17px, 1.6vw, 19px); color: #3F5368; max-width: 580px">{s.intro1}</p>
        <p style="margin: 0; font-size: 17px; color: #4A5D70; max-width: 580px">{s.intro2}</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px">
          <a href={routes.book} style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 999px; background: #0D7A80; color: #FFFFFF; font-weight: 800; font-size: 17px; text-decoration: none">{s.bookLabel}</a>
          <a href={phones.cumc.tel} style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; background: #FFFFFF; border: 2px solid #0D7A80; color: #0D7A80; font-weight: 800; font-size: 17px; text-decoration: none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
            Call the Clinic
          </a>
        </div>
      </div>
      <div style="flex: 1 1 380px; min-width: 0">
        <div style="display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; align-items: end">
          <img src={s.img1} alt={s.alt1} fetchpriority="high" style={`grid-column: span 3; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: ${s.pos1}; border-radius: 40px 40px 40px 100px; border: 6px solid #FFFFFF; box-sizing: border-box; display: block; box-shadow: 0 24px 60px rgba(23, 50, 77, 0.12)`}>
          <img src={s.img2} alt={s.alt2} style={`grid-column: span 2; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: ${s.pos2}; border-radius: 30px; border: 6px solid #FFFFFF; box-sizing: border-box; display: block; box-shadow: 0 18px 44px rgba(23, 50, 77, 0.1)`}>
        </div>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px">
      <div style="display: flex; gap: 14px; align-items: center; padding: 18px 20px; border-radius: 20px; background: #FFFFFF">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"></path></svg>
        <span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-size: 13px; font-weight: 800; color: #4A5D70; text-transform: uppercase; letter-spacing: 0.06em">For</span><span style="font-weight: 800">{s.forWho}</span></span>
      </div>
      <div style="display: flex; gap: 14px; align-items: center; padding: 18px 20px; border-radius: 20px; background: #FFFFFF">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-size: 13px; font-weight: 800; color: #4A5D70; text-transform: uppercase; letter-spacing: 0.06em">Where</span><span style="font-weight: 800">CUMC &amp; Maria Reyna–XU</span></span>
      </div>
      <div style="display: flex; gap: 14px; align-items: center; padding: 18px 20px; border-radius: 20px; background: #FFFFFF">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0D7A80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        <span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-size: 13px; font-weight: 800; color: #4A5D70; text-transform: uppercase; letter-spacing: 0.06em">Book</span><span style="font-weight: 800">By phone with the secretary</span></span>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section style="padding: clamp(64px, 8vw, 96px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
    <div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">How it works</span>
      <h2 style="margin: 0; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.15; font-weight: 800">How It Works</h2>
      <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
        {covers.map((c) => (
          <li style="display: flex; gap: 14px; align-items: center; padding: 16px 18px; border-radius: 18px; border: 1px solid #E1ECEE; background: #FFFFFF">
            <span style={c.dot}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
            <span style="font-size: 18px; font-weight: 800; line-height: 1.3">{c.t}</span>
          </li>
        ))}
      </ul>
    </div>
    <div style="flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
      <img src={s.img3} alt={s.alt3} loading="lazy" style={`width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: ${s.pos3}; border-radius: 32px; display: block`}>
      <p style="margin: 0; font-size: 18px; line-height: 1.7; color: #3F5368">{s.expectIntro}</p>
    </div>
  </div>
</section>

<!-- RELATED FAQS -->
<section style="background: #F7FBFB; padding: clamp(64px, 8vw, 96px) 0">
  <div style="max-width: 860px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 24px">
    <div style="display: flex; flex-direction: column; gap: 12px">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">Related questions</span>
      <h2 style="margin: 0; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.15; font-weight: 800">Frequently Asked Questions</h2>
      <p style="margin: 0; color: #3F5368">{s.faqSub}</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 12px">
      <FaqList faqs={s.faqs} />
    </div>
  </div>
</section>

<!-- BOOK CTA + OTHER SERVICES -->
<section style="padding: clamp(64px, 8vw, 96px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 48px">
    <div style="position: relative; overflow: hidden; border-radius: 36px; background: #0D7A80; color: #FFFFFF; padding: clamp(36px, 5vw, 56px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px">
      <div aria-hidden="true" style="position: absolute; width: 240px; height: 240px; border-radius: 50%; background: #13878D; right: -60px; top: -90px"></div>
      <div style="position: relative; flex: 1 1 420px; display: flex; flex-direction: column; gap: 10px">
        <h2 style="margin: 0; font-size: clamp(26px, 3.2vw, 38px); line-height: 1.15; font-weight: 800">Book an Appointment</h2>
        <p style="margin: 0; font-size: 18px; color: #E3F4F3">Call the clinic secretary to schedule your child’s visit with Dr. Vira.</p>
      </div>
      <div style="position: relative; display: flex; flex-wrap: wrap; gap: 12px">
        <a href={routes.book} style="display: inline-flex; align-items: center; min-height: 56px; padding: 0 26px; border-radius: 999px; background: #FFFFFF; color: #0A5F64; font-weight: 800; text-decoration: none">See clinics &amp; schedules</a>
        <a href={phones.cumc.tel} style="display: inline-flex; align-items: center; gap: 8px; min-height: 56px; padding: 0 24px; border-radius: 999px; border: 2px solid #FFFFFF; color: #FFFFFF; font-weight: 800; text-decoration: none">Call {phones.cumc.display}</a>
      </div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 18px">
      <h2 style="margin: 0; font-size: 24px; font-weight: 800">Related services</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px">
        {s.related.map((o) => (
          <a href={o.href} style="display: flex; flex-direction: column; gap: 10px; padding: 26px; border-radius: 26px; border: 1px solid #E1ECEE; background: #FFFFFF; text-decoration: none; color: #17324D">
            <span style="font-size: 20px; font-weight: 800; line-height: 1.3">{o.title}</span>
            <span style="font-size: 16px; color: #4A5D70">{o.desc}</span>
            <span style="margin-top: 4px; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; color: #0D7A80">Read More <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
</BaseLayout>
