---
import BaseLayout from '../layouts/BaseLayout.astro';
import { maps, phones, bookingBackendUrl } from '../data/site';

// Bookings go to the clinic's existing Google Apps Script backend (the same one the
// previous WordPress site used), which keeps the clinic calendar in sync.
const fallbackPhones = `CUMC ${phones.cumc.display} or Maria Reyna ${phones.mrxu.display}`;

const places = [
  { name: 'Capitol University Medical Center', detail: 'Gusa Highway, Cagayan de Oro City, Misamis Oriental Room 206B', map: maps.cumc },
  { name: 'Maria Reyna – Xavier University Hospital', detail: 'Room 547', map: maps.mrxu },
  { name: 'J.R. Borja General Hospital', detail: 'Medical Specialist IV, Pediatrics', map: maps.jrb },
  { name: 'Madonna and Child Medical Center', detail: 'Hospital affiliation', map: maps.madonna },
];

const steps = [
  { n: '1', t: 'Choose a Clinic', d: 'Pick the location most convenient for you: CUMC or Maria Reyna–XU Hospital.' },
  { n: '2', t: 'Call to Book', d: 'Contact the clinic secretary to check availability and set a schedule.' },
  { n: '3', t: 'Confirm Your Slot', d: 'Receive confirmation of your appointment date and time.' },
  { n: '4', t: 'Meet Dr. Vira', d: 'Bring your child’s health records (if any) to your visit.' },
];
---
<BaseLayout
  title="Book an Appointment — Dr. Vira Bolok, MD"
  description="Book an appointment with Dr. Vira at Capitol University Medical Center or Maria Reyna–Xavier University Hospital: choose a clinic, check available times and request your slot online."
  active="book"
>
<!-- MAKE AN APPOINTMENT -->
<section style="background: #F2F9F8; position: relative; overflow: hidden">
  <div aria-hidden="true" style="position: absolute; width: 360px; height: 360px; border-radius: 50%; background: #E1F1F0; right: -120px; top: -140px"></div>
  <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(40px, 6vw, 80px) 24px; display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 64px); align-items: flex-start">
    <div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">Booking Now</span>
      <h1 style="margin: 0; font-size: clamp(36px, 5vw, 56px); line-height: 1.08; font-weight: 800">Make An Appointment</h1>
      <p style="margin: 0; font-size: clamp(17px, 1.6vw, 19px); color: #3F5368">Choose the clinic location and schedule most convenient for your family, then contact the clinic secretary to book your visit.</p>
      <div style="display: flex; flex-direction: column; gap: 4px; padding-top: 8px">
        <h2 style="margin: 0; font-size: 20px; font-weight: 800">Capitol University Medical Center</h2>
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #D5E9E8"><span style="color: #3F5368">Mon, Tue, Thu, Fri</span><span style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700"><span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #0D7A80"></span>9:00 AM – 12:00 PM</span></div>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 4px">
        <h2 style="margin: 0; font-size: 20px; font-weight: 800">Maria Reyna – Xavier University Hospital</h2>
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #D5E9E8"><span style="color: #3F5368">Tue &amp; Thu</span><span style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700"><span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #0D7A80"></span>3:00 PM – 5:00 PM</span></div>
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #D5E9E8"><span style="color: #3F5368">Fri</span><span style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700"><span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #0D7A80"></span>1:00 PM – 5:00 PM</span></div>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 10px; padding-top: 6px">
        <h2 style="margin: 0; font-size: 20px; font-weight: 800">Support</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px">
          <a href="tel:+639274286149" style="display: flex; align-items: center; gap: 14px; min-height: 56px; text-decoration: none; color: #17324D">
            <span style="width: 48px; height: 48px; border-radius: 50%; background: #0D7A80; color: #FFFFFF; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></span>
            <span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-weight: 800; font-size: 17px">CUMC</span><span style="color: #3F5368">0927 428 6149</span></span>
          </a>
          <a href="tel:+639352894650" style="display: flex; align-items: center; gap: 14px; min-height: 56px; text-decoration: none; color: #17324D">
            <span style="width: 48px; height: 48px; border-radius: 50%; background: #0D7A80; color: #FFFFFF; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></span>
            <span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-weight: 800; font-size: 17px">Maria Reyna</span><span style="color: #3F5368">0935 289 4650</span></span>
          </a>
        </div>
      </div>
    </div>

    <div style="flex: 1 1 400px; min-width: 0; padding: clamp(22px, 3vw, 32px); border-radius: 32px; background: #FFFFFF; box-shadow: 0 20px 50px rgba(23, 50, 77, 0.10)">
      <div data-dv-booking data-backend={bookingBackendUrl} data-fallback={fallbackPhones} style="display: flex; flex-direction: column; gap: 16px; padding: clamp(18px, 2.4vw, 26px); border-radius: 22px; border: 1px solid #E1ECEE">
        <h2 style="margin: 0; font-size: 22px; font-weight: 800">Book an Appointment</h2>
        <div data-dv-booking-stage aria-live="polite">
          <div style="display: flex; flex-direction: column; gap: 14px">
            <span style="font-weight: 800; font-size: 15px">Choose a clinic</span>
            <span style="color: #4A5D70; font-weight: 700">Loading clinics…</span>
          </div>
        </div>
        <noscript>
          <p style="margin: 0; color: #3F5368">Online booking needs JavaScript. Please call {fallbackPhones} to book.</p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<!-- STEPS + WHERE TO FIND -->
<section style="padding: clamp(64px, 8vw, 96px) 0">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 24px">
    <div style="display: flex; flex-direction: column; gap: 18px; padding: 32px; border-radius: 32px; background: #FFF6F1">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #B4492F">Where to Find Dr. Vira</span>
      <h2 style="margin: 0; font-size: clamp(26px, 3vw, 34px); line-height: 1.15; font-weight: 800">Visit Dr. Vira at Any of Her Clinics</h2>
      <p style="margin: 0; color: #3F5368">Dr. Vira sees patients at multiple clinics across Cagayan de Oro, so you can choose the location and schedule that’s most convenient for your family. Check each clinic’s hours below and book your visit today.</p>
      <ul style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px">
        {places.map((p) => (
          <li style="display: flex; gap: 14px; padding: 16px; border-radius: 18px; background: #FFFFFF">
            <span style="width: 44px; height: 44px; border-radius: 14px; background: #FFF1EA; color: #B4492F; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M12 8v5"></path><path d="M9.5 10.5h5"></path><path d="M10 21v-4h4v4"></path></svg></span>
            <span style="display: flex; flex-direction: column; gap: 4px; min-width: 0">
              <span style="font-weight: 800; font-size: 17px; line-height: 1.3">{p.name}</span>
              <span style="font-size: 15px; color: #3F5368">{p.detail}</span>
              <a href={p.map} style="align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 800; color: #0D7A80; text-decoration: none; font-size: 15px">View on map</a>
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div style="display: flex; flex-direction: column; gap: 18px">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #1F5F8F">Book an Appointment</span>
      <h2 style="margin: 0; font-size: clamp(28px, 3.4vw, 38px); line-height: 1.15; font-weight: 800">Easy Steps to See Dr. Vira</h2>
      <p style="margin: 0; color: #3F5368">Getting your child the care they need is simple. Just choose a clinic, book your schedule, and Dr. Vira will be ready to see you and your little one.</p>
      <ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
        {steps.map((s) => (
          <li style="display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border-radius: 20px; background: #EAF3FB">
            <span style="width: 40px; height: 40px; border-radius: 50%; background: #FFFFFF; color: #1F5F8F; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0">{s.n}</span>
            <span style="display: flex; flex-direction: column"><span style="font-weight: 800; font-size: 18px">{s.t}</span><span style="font-size: 16px; color: #3F5368">{s.d}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import '../scripts/booking';
</script>
</BaseLayout>
